{
  "manifest_version": 3,
  "name": "Tradingdesk – RateProbability",
  "version": "1.1.0",
  "description": "Übernimmt sichtbare Rates-Daten auf Anforderung in deine Wochenanalyse.",
  "permissions": ["scripting"],
  "host_permissions": ["https://rateprobability.com/*"],
  "background": {"service_worker": "worker.js"},
  "content_scripts": [{
    "matches": ["https://nevio111998.github.io/tradingdesk/*"],
    "js": ["bridge.js"]
  }]
}
